datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum Role {
  SHOP
  CREATOR
}

enum SubscriptionPlan {
  FREE
  PRO
  ULTRA
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum JobStatus {
  DRAFT
  RECRUITING
  IN_PROGRESS
  COMPLETED
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  password       String
  role           Role
  plan           SubscriptionPlan @default(FREE)
  hearts         Int              @default(0)      // Số lượng trái tim đang sở hữu
  connects       Int              @default(0)      // Lượt kết nối còn lại (từ gói cước)
  trialEndsAt    DateTime?                         // Ngày hết hạn dùng thử free 1 tháng
  createdAt      DateTime         @default(now())
  
  shopProfile    ShopProfile?
  creatorProfile CreatorProfile?
  jobs           Job[]                             // Quan hệ: Shop đăng Job
  transactions   Transaction[]                     // Lịch sử giao dịch ví/nạp tiền
  applications   Application[]                     // Đơn ứng tuyển của Creator
  
  givenReviews    Review[] @relation("ShopReviews")
  receivedReviews Review[] @relation("CreatorReviews")
}

model ShopProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName        String?  // Tên cửa hàng
  description     String?  // Mô tả chi tiết về cửa hàng
  categories      String[] // ["Thời trang", "Mỹ phẩm", "Phụ kiện"...]
  vibeText        String?  // Mô tả vibe phong cách của Shop (AI dùng để so sánh)
  website         String?  // Link website cửa hàng
  instagram       String?  // Instagram handle hoặc link
  phone           String?  // Số điện thoại liên hệ
  address         String?  // Địa chỉ cửa hàng
  averageRating   Float    @default(0) // Đánh giá trung bình từ Creator
  totalJobs       Int      @default(0) // Tổng số công việc đã đăng
  feedback        String?  // Đánh giá đóng góp
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CreatorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?  // Mô tả bản thân
  styles      String[] // ["Streetwear", "Vintage", "Minimalism"...]
  portfolioUrl String?
  feedback    String?
  mainImage   String?  // Ảnh chính của Creator
  gallery     String[] // Danh sách các ảnh phụ
}

model Job {
  id           String        @id @default(cuid())
  shopId       String
  shop         User          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title        String
  description  String        // Nội dung tuyển dụng gốc
  aiSummary    String?       // Đoạn tóm tắt ngầm do AI xử lý
  budget       String        // Sửa Float thành String nếu bạn muốn lưu định dạng "5,000,000đ - 10,000,000đ" (Hoặc giữ Float và format ở Frontend)
  status       JobStatus     @default(DRAFT) // Trạng thái bài post
  vibeTags     String[]      // Mảng lưu các tags: ["GenZ", "Thời trang"]
  createdAt    DateTime      @default(now())
  applications Application[]
  milestones   Milestone[]
  reviews      Review[]
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  matchRate   Int      @default(0) // Tỉ lệ % phù hợp do AI tính toán (Ví dụ: 85%)
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt   DateTime @default(now())
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float             // Số tiền giao dịch
  fee         Float             @default(0) // Phí trung gian 3% thu của hệ thống
  type        String            // "DEPOSIT" (Nạp tiền), "WITHDRAW" (Rút tiền), "PAY_JOB" (Trả tiền job)
  status      TransactionStatus @default(PENDING)
  createdAt   DateTime          @default(now())
}

model Milestone {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title       String   // Tên bước: "Lên kịch bản", "Quay video", "Chỉnh sửa"
  type        String   @default("SCRIPT") // SCRIPT, VIDEO, LINK, PAYMENT
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, REVIEWING, COMPLETED, REJECTED
  submission  String?  // Nội dung Creator nộp (Text kịch bản, Link Google Drive, Link TikTok...)
  feedback    String?  // Chỗ để Shop note lại yêu cầu chỉnh sửa
  order       Int      @default(0) // Thứ tự hiển thị
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  shopId      String   // Shop người viết đánh giá
  shop        User     @relation("ShopReviews", fields: [shopId], references: [id], onDelete: Cascade)
  
  creatorId   String   // Creator nhận đánh giá
  creator     User     @relation("CreatorReviews", fields: [creatorId], references: [id], onDelete: Cascade)
  
  jobId       String?  // Có thể đánh giá thông qua một Job cụ thể
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  rating      Int      @default(5) // Điểm đánh giá (1-5 sao)
  content     String   // Nội dung đánh giá
  createdAt   DateTime @default(now())
}